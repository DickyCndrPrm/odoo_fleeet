<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_form_view_inherit_bastk" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.bastk</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_bastk" icon="fa-file-text-o">
                    <field name="bastk_count" widget="statinfo" string="BASTK"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>