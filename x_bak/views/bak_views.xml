<odoo>

    <!-- ===================== -->
    <!-- ACTION -->
    <!-- ===================== -->
    <record id="action_bak" model="ir.actions.act_window">
        <field name="name">BAK</field>
        <field name="res_model">bak</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- MENU -->
    <!-- ===================== -->
    <menuitem id="menu_bak" name="BAK" parent="x_service_planning.menu_service_root" action="action_bak" sequence="2"/>

    <!-- ===================== -->
    <!-- LIST VIEW -->
    <!-- ===================== -->
    <record id="view_bak_list" model="ir.ui.view">
        <field name="name">bak.list</field>
        <field name="model">bak</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="incident_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ===================== -->
    <!-- FORM VIEW -->
    <!-- ===================== -->
    <record id="view_bak_form" model="ir.ui.view">
        <field name="name">bak.form</field>
        <field name="model">bak</field>
        <field name="arch" type="xml">
            <form string="Berita Acara Kejadian">

                <!-- HEADER BUTTON -->
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>

                    <button name="action_approve" type="object" string="Approve" class="btn-success" invisible="state != 'submitted'"/>

                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>

                <sheet>

                    <!-- INFORMASI UMUM -->
                    <group col="2">
                        <field name="name" readonly="1" required="1"/>
                        <field name="partner_id"/>
                        <field name="driver_name"/>
                        <field name="address"/>
                        <field name="phone"/>
                    </group>

                    <!-- DATA KENDARAAN -->
                    <group string="Informasi Kendaraan">
                        <field name="vehicle_id"/>
                        <field name="license_plate" readonly="1"/>
                        <field name="year" readonly="1"/>
                        <field name="last_odometer"/>
                    </group>

                    <!-- KEJADIAN -->
                    <group string="Detail Kejadian">
                        <field name="incident_date"/>
                        <field name="location"/>
                        <field name="chronology"/>
                        <field name="damage"/>
                    </group>

                    <!-- BIAYA & DOKUMEN -->
                    <group string="Biaya &amp; Dokumen">
                        <field name="cost"/>
                        <field name="ticket_number"/>
                        <field name="attachment"/>
                    </group>

                    <!-- FOTO -->
                    <group string="Foto Kejadian">
                        <field name="image" widget="image" class="oe_avatar"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>