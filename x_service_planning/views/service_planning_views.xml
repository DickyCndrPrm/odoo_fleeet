<odoo>

    <!-- ===================== -->
    <!-- ACTION -->
    <!-- ===================== -->
    <record id="action_service_planning" model="ir.actions.act_window">
        <field name="name">Service Planning</field>
        <field name="res_model">service.planning</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== -->
    <!-- MENU ROOT -->
    <!-- ===================== -->
    <menuitem id="menu_service_root"
              name="Service Management"
              sequence="10"/>

    <!-- ===================== -->
    <!-- SUB MENU -->
    <!-- ===================== -->
    <menuitem id="menu_service_planning"
              name="Service Planning"
              parent="menu_service_root"
              action="action_service_planning"
              sequence="1"/>

    <!-- ===================== -->
    <!-- LIST VIEW (ODDO 19) -->
    <!-- ===================== -->
    <record id="view_service_planning_list" model="ir.ui.view">
        <field name="name">service.planning.list</field>
        <field name="model">service.planning</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="service_part"/>
                <field name="kilometer"/>
                <field name="interval"/>
            </list>
        </field>
    </record>

    <!-- ===================== -->
    <!-- FORM VIEW -->
    <!-- ===================== -->
    <record id="view_service_planning_form" model="ir.ui.view">
        <field name="name">service.planning.form</field>
        <field name="model">service.planning</field>
        <field name="arch" type="xml">
            <form>

            <header>
                <button name="action_create_spk"
                        type="object"
                        string="Create SPK"
                        class="btn-primary"/>
            </header>
                <sheet>

                    <!-- INFORMASI UNIT -->
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="vehicle_id"/>
                        <field name="asset_number" readonly="1"/>
                        <field name="engine_number" readonly="1"/>
                        <field name="color" readonly="1"/>
                        <field name="license_plate" readonly="1"/>
                        <field name="vin_number" readonly="1"/>
                    </group>

                    <!-- SERVICE -->
                    <group>
                        <field name="service_part"/>
                        <field name="kilometer"/>
                        <field name="interval"/>
                    </group>

                    <!-- TAMBAHAN -->
                    <group>
                        <field name="brand_recommendation"/>
                        <field name="remarks"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>